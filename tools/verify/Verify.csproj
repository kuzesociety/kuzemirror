<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the shipped strategy against NinjaTrader stubs as C# 5 (NinjaTrader 8's compiler level). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Verify</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NtStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../../ninjatrader/Strategies/RutaCryptoMirror.cs" />
  </ItemGroup>
</Project>
